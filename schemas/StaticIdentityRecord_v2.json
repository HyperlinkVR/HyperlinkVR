{
    "$id": "https://hyperlink.surf/schemas/StaticIdentityRecord_v2.json",
    "version": 2,
    "title": "HyperlinkVR - Static Identity Record (version 2)",
    "description": "A static identity record for HyperlinkVR to authenticate users on a static site, under the .well-known/hyperlinkvr/auth/* path. This schema is version 2.",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
        "$schema": {
            "default": "https://hyperlink.surf/schemas/StaticIdentityRecord_v2.json",
            "type": "string"
        },
        "version": {
            "type": "integer",
            "const": 2
        },
        "uuid": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "identity": {
            "type": "string",
            "minLength": 3,
            "maxLength": 64
        },
        "created_at": {
            "type": "number"
        },
        "status": {
            "type": "string",
            "enum": [
                "active",
                "suspended"
            ]
        },
        "auth": {
            "type": "object",
            "properties": {
                "password_deriv": {
                    "type": "object",
                    "properties": {
                        "algorithm": {
                            "type": "string",
                            "enum": [
                                "argon2"
                            ]
                        },
                        "custom": {
                            "type": "object",
                            "properties": {
                                "salt": {
                                    "type": "string"
                                },
                                "iv": {
                                    "type": "string"
                                }
                            },
                            "required": [
                                "salt",
                                "iv"
                            ]
                        }
                    },
                    "required": [
                        "algorithm",
                        "custom"
                    ]
                },
                "encrypted_private_key": {
                    "type": "string"
                },
                "public_key": {
                    "anyOf": [
                        {
                            "type": "object",
                            "properties": {
                                "kty": {
                                    "type": "string",
                                    "const": "EC"
                                },
                                "crv": {
                                    "type": "string",
                                    "enum": [
                                        "P-256",
                                        "P-384",
                                        "P-521"
                                    ]
                                },
                                "x": {
                                    "type": "string"
                                },
                                "y": {
                                    "type": "string"
                                },
                                "ext": {
                                    "type": "boolean"
                                }
                            },
                            "required": [
                                "kty",
                                "crv",
                                "x",
                                "y"
                            ]
                        },
                        {
                            "type": "object",
                            "properties": {
                                "kty": {
                                    "type": "string",
                                    "const": "OKP"
                                },
                                "crv": {
                                    "type": "string",
                                    "const": "Ed25519"
                                },
                                "x": {
                                    "type": "string"
                                },
                                "ext": {
                                    "type": "boolean"
                                }
                            },
                            "required": [
                                "kty",
                                "crv",
                                "x"
                            ]
                        }
                    ]
                }
            },
            "required": [
                "password_deriv",
                "encrypted_private_key",
                "public_key"
            ]
        }
    },
    "required": [
        "version",
        "uuid",
        "identity",
        "created_at",
        "status",
        "auth"
    ]
}