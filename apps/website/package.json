{
    "name": "@hyperlinkvr/website",
    "type": "module",
    "version": "0.0.1",
    "private": true,
    "description": "Static site and official worlds.",
    "scripts": {
        "sync:ui-dom": "turbo run build:web --filter=@hyperlinkvr/ui-dom && shx cp -r ../../packages/ui-dom/dist/. ./public/ui-dom/",
        "dev": "pnpm run sync:ui-dom && vite",
        "build": "pnpm run sync:ui-dom && vite build",
        "build:web": "vite build",
        "preview": "vite preview",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@hyperlinkvr/ui-dom": "workspace:*",
        "@hyperlinkvr/styles": "workspace:*",
        "react": "catalog:",
        "react-dom": "catalog:",
        "lucide-react": "catalog:"
    },
    "devDependencies": {
        "@hyperlinkvr/web-sdk": "workspace:*",
        "@tailwindcss/vite": "catalog:",
        "@types/react": "catalog:",
        "@types/react-dom": "catalog:",
        "@vitejs/plugin-react": "^6.1.1",
        "tailwindcss": "catalog:",
        "typescript": "5.9.3",
        "vite": "^8.1.0"
    }
}
