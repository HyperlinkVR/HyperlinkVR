{
    "extends": ["../../tsconfig.base.json", "./.wxt/tsconfig.json"],
    "exclude": ["node_modules"],
    "include": ["src/**/*", ".wxt/types/**/*.d.ts", "wxt.config.ts"],
    "compilerOptions": {
        "paths": {
            "~*": ["src/*"],
            "three/examples/jsm/*": ["node_modules/@types/three/examples/jsm/*"],
            "three/addons/*": ["node_modules/@types/three/examples/jsm/*"]
        },
        "baseUrl": ".",
        "composite": false,
        "resolveJsonModule": true,
        "verbatimModuleSyntax": false
    }
}
