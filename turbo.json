{
    "$schema": "https://turbo.build/schema.json",
    "ui": "tui",
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "outputs": ["build/**", "dist/**"]
        },
        "build:web": {
            "dependsOn": ["@hyperlinkvr/deact#build"],
            "outputs": ["build/**", "dist/**"]
        },
        "build:play": {
            "outputs": ["dist/**"]
        },
        "//#build:schema": {
            "outputs": ["schemas/**"]
        },
        "dev": {
            "cache": false,
            "persistent": true
        },
        "typecheck": {
            "dependsOn": [],
            "cache": true
        }
    }
}
