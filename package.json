{
    "name": "hyperlinkvr",
    "description": "The hyperspace navigator.",
    "license": "AGPL-3.0-only",
    "private": true,
    "packageManager": "pnpm@10.19.0",
    "homepage": "https://hyperlink.surf",
    "scripts": {
        "dev": "turbo run dev",
        "build": "turbo run build",
        "build:extension": "cd apps/extension && pnpm build",
        "build:schema": "tsx scripts/build_json_schema.ts",
        "build:website": "cd apps/website && pnpm build",
        "build:docs": "cd apps/docs && pnpm build",
        "build:ui-dom-deact": "cd packages/ui-dom && pnpm run build:deact",
        "build:web-all": "turbo run build:web //#build:schema && pnpm run copy:web-all",
        "copy:web-all": "shx cp -r apps/docs/build/. apps/website/dist/docs/ && shx cp -r schemas/. apps/website/dist/schemas/ && shx cp -r packages/ui-dom/dist/. apps/website/dist/ui-dom/",
        "typecheck": "turbo run typecheck --output-logs=errors-only --continue",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "unused": "knip"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@ianvs/prettier-plugin-sort-imports": "4.1.1",
        "eslint": "^10.9.1",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.11.0",
        "knip": "^6.20.0",
        "prettier": "3.2.4",
        "shx": "^0.4.0",
        "tsx": "^4.22.4",
        "turbo": "latest",
        "typescript": "5.9.3",
        "typescript-eslint": "^8.68.0"
    },
    "engines": {
        "node": ">=22.12.0"
    }
}
